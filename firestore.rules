rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Identity Service Collections
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Only Cloud Functions create users
    }
    match /user_profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /user_preferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /user_ai_context/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Backend handles AI context
    }
    match /user_sessions/{sessionId} {
      allow read, update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if false;
    }
    match /audit_logs/{logId} {
      allow read, write: if false; // Backend only
    }

    // Financial Engine Collections
    match /transactions/{transactionId} {
      allow read: if request.auth != null && resource.data.createdBy == request.auth.uid;
      allow write: if false; // Processed by Cloud Functions
    }

    // Financial Intelligence Collections
    match /financial_intelligence/{snapshotId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false; // Generated by Backend
    }

    // Goals Engine Collections
    match /goals/{goalId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false; // Managed by Backend API
    }

    // Travel Intelligence Collections
    match /trips/{tripId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false; // Managed by Backend API
    }

    // Community Platform Collections
    match /communities/{communityId} {
      allow read: if request.auth != null;
      allow write: if false; // Managed by Backend API
    }
    match /community_members/{memberId} {
      allow read: if request.auth != null;
      allow write: if false; // Managed by Backend API
    }
    match /community_posts/{postId} {
      allow read: if request.auth != null;
      allow write: if false; // Managed by Backend API
    }

    // Reputation Engine Collections
    match /reputation_profiles/{profileId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false; // Managed by Eventarc & Backend
    }
    match /reputation_history/{historyId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false; // Managed by Eventarc & Backend
    }
  }
}