datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum AccountType {
  SAVINGS
  CHECKING
  CREDIT
  INVESTMENT
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum LendingStatus {
  PENDING
  FUNDED
  ACTIVE
  REPAID
  DEFAULTED
}

enum ConsentStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model User {
  id               String           @id @default(uuid())
  mobileNumber     String?          @unique
  email            String?          @unique
  passwordHash     String?
  isMobileVerified Boolean          @default(false)
  firstName        String?
  lastName         String?
  role             Role             @default(USER)
  reputationScore  Int              @default(780)
  reputationTitle  String           @default("Reliable Peer")
  onboardingStep   String           @default("ACTIVE")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  accounts         Account[]
  transactions     Transaction[]
  goals            Goal[]
  trips            Trip[]
  lendingRequests  LendingRequest[]
  consents         Consent[]
  auditLogs        AuditLog[]
  devices          UserDevice[]
  passkeys         PasskeyCredential[]
  sessions         UserSession[]
  authAuditLogs    AuthenticationAuditLog[]

  @@map("users")
}

model OtpVerification {
  id           String   @id @default(uuid())
  mobileNumber String
  otpHash      String
  attempts     Int      @default(0)
  maxAttempts  Int      @default(3)
  expiresAt    DateTime
  isUsed       Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([mobileNumber, isUsed])
  @@map("otp_verifications")
}

model UserDevice {
  id           String              @id @default(uuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceName   String
  userAgent    String?
  ipAddress    String?
  lastActiveAt DateTime            @default(now())
  createdAt    DateTime            @default(now())

  passkeys     PasskeyCredential[]
  sessions     UserSession[]

  @@index([userId])
  @@map("user_devices")
}

model PasskeyCredential {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId     String?
  device       UserDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  credentialId String      @unique
  publicKey    Bytes
  counter      BigInt      @default(0)
  deviceType   String      @default("singleDevice")
  backedUp     Boolean     @default(false)
  transports   String[]    @default([])
  createdAt    DateTime    @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
  @@map("passkey_credentials")
}

model PasskeyChallenge {
  id        String   @id @default(uuid())
  userId    String?
  challenge String   @unique
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([challenge])
  @@map("passkey_challenges")
}

model UserSession {
  id               String      @id @default(uuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId         String?
  device           UserDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  refreshTokenHash String      @unique
  expiresAt        DateTime
  isRevoked        Boolean     @default(false)
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([userId, isRevoked])
  @@map("user_sessions")
}

model AuthenticationAuditLog {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  mobileNumber String?
  event        String
  status       String
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([mobileNumber])
  @@map("authentication_audit_logs")
}

model Account {
  id                  String        @id @default(uuid())
  userId              String
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankName            String
  accountNumberMasked String
  accountType         AccountType   @default(SAVINGS)
  balance             Decimal       @default(0.0)
  currency            String        @default("INR")
  isConnected         Boolean       @default(true)
  aaConnectionId      String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  transactions        Transaction[]

  @@map("accounts")
}

model Transaction {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId   String?
  account     Account?        @relation(fields: [accountId], references: [id], onDelete: SetNull)
  title       String
  amount      Decimal
  category    String
  type        TransactionType @default(EXPENSE)
  date        DateTime        @default(now())
  note        String?
  createdAt   DateTime        @default(now())

  @@map("transactions")
}

model Goal {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  targetAmount  Decimal
  currentAmount Decimal  @default(0.0)
  category      String
  deadline      DateTime?
  isCompleted   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("goals")
}

model Trip {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination    String
  budget         Decimal
  spent          Decimal  @default(0.0)
  startDate      DateTime?
  endDate        DateTime?
  travelersCount Int      @default(1)
  isCompleted    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("trips")
}

model LendingRequest {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason       String
  amount       Decimal
  termMonths   Int           @default(3)
  interestRate Decimal       @default(4.5)
  status       LendingStatus @default(PENDING)
  fundedAmount Decimal       @default(0.0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("lending_requests")
}

model Consent {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    String
  status     ConsentStatus @default(ACTIVE)
  validUntil DateTime
  grantedAt  DateTime      @default(now())
  metadata   Json?

  @@map("consents")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  resource  String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}
