datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum AccountType {
  SAVINGS
  CHECKING
  CREDIT
  INVESTMENT
  DEPOSIT
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum LendingStatus {
  PENDING
  FUNDED
  ACTIVE
  REPAID
  DEFAULTED
}

enum ConsentStatus {
  PENDING
  APPROVED
  ACTIVE
  REJECTED
  REVOKED
  EXPIRED
}

enum ConsentEventType {
  REQUESTED
  APPROVED
  REJECTED
  EXPIRED
  REVOKED
  FETCHED
}

enum AAConnectionStatus {
  PENDING
  ACTIVE
  FAILED
  DISCONNECTED
}

enum AALinkingSessionStatus {
  INITIATED
  REDIRECTED
  DISCOVERED
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
}

enum LinkedAccountStatus {
  LINKED
  DELINKED
  CONSENT_PENDING
  SYNC_FAILED
}

enum CallbackStatus {
  PROCESSED
  FAILED
  DUPLICATE
  INVALID_SIGNATURE
}

model User {
  id                 String                   @id @default(uuid())
  mobileNumber       String?                  @unique
  email              String?                  @unique
  passwordHash       String?
  isMobileVerified   Boolean                  @default(false)
  firstName          String?
  lastName           String?
  role               Role                     @default(USER)
  reputationScore    Int                      @default(780)
  reputationTitle    String                   @default("Reliable Peer")
  onboardingStep     String                   @default("ACTIVE")
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  accounts           Account[]
  linkedBankAccounts LinkedBankAccount[]
  aaConnections      AaConnection[]
  aaLinkingSessions  AaLinkingSession[]
  transactions       Transaction[]
  goals              Goal[]
  trips              Trip[]
  lendingRequests    LendingRequest[]
  consents           Consent[]
  auditLogs          AuditLog[]
  devices            UserDevice[]
  passkeys           PasskeyCredential[]
  sessions           UserSession[]
  authAuditLogs      AuthenticationAuditLog[]

  @@map("users")
}

model OtpVerification {
  id           String   @id @default(uuid())
  mobileNumber String
  otpHash      String
  attempts     Int      @default(0)
  maxAttempts  Int      @default(3)
  expiresAt    DateTime
  isUsed       Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([mobileNumber, isUsed])
  @@map("otp_verifications")
}

model UserDevice {
  id           String              @id @default(uuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceName   String
  userAgent    String?
  ipAddress    String?
  lastActiveAt DateTime            @default(now())
  createdAt    DateTime            @default(now())

  passkeys     PasskeyCredential[]
  sessions     UserSession[]

  @@index([userId])
  @@map("user_devices")
}

model PasskeyCredential {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId     String?
  device       UserDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  credentialId String      @unique
  publicKey    Bytes
  counter      BigInt      @default(0)
  deviceType   String      @default("singleDevice")
  backedUp     Boolean     @default(false)
  transports   String[]    @default([])
  createdAt    DateTime    @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
  @@map("passkey_credentials")
}

model PasskeyChallenge {
  id        String   @id @default(uuid())
  userId    String?
  challenge String   @unique
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([challenge])
  @@map("passkey_challenges")
}

model UserSession {
  id               String      @id @default(uuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId         String?
  device           UserDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  refreshTokenHash String      @unique
  expiresAt        DateTime
  isRevoked        Boolean     @default(false)
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([userId, isRevoked])
  @@map("user_sessions")
}

model AuthenticationAuditLog {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  mobileNumber String?
  event        String
  status       String
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([mobileNumber])
  @@map("authentication_audit_logs")
}

// ---------------------------------------------------------------------------
// Account Aggregator (AA) & Bank Linking Models
// ---------------------------------------------------------------------------

model AaConnection {
  id                String             @id @default(uuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId        String             // "SETU", "ANUMATI", "ONEMONEY", "FINVU", "MOCK_AA"
  providerName      String             // "Setu AA", "Anumati (Perfios)", "OneMoney", "Finvu", "Sahamati Mock"
  aaCustomerHandle  String?            // e.g. "9876543210@onemoney"
  status            AAConnectionStatus @default(PENDING)
  metadata          Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  linkingSessions   AaLinkingSession[]
  linkedAccounts    LinkedBankAccount[]
  consents          Consent[]

  @@unique([userId, providerId])
  @@index([userId, status])
  @@map("aa_connections")
}

model AaLinkingSession {
  id                 String                 @id @default(uuid())
  userId             String
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  aaConnectionId     String?
  aaConnection       AaConnection?          @relation(fields: [aaConnectionId], references: [id], onDelete: SetNull)
  providerId         String
  correlationId      String                 @unique // Cryptographic correlation token for redirect & callbacks
  redirectUrl        String                 // Authorized hosted AA portal URL
  status             AALinkingSessionStatus @default(INITIATED)
  discoveredAccounts Json?                  // Discovered accounts payload
  errorReason        String?
  expiresAt          DateTime
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([userId])
  @@index([correlationId])
  @@map("aa_linking_sessions")
}

model LinkedBankAccount {
  id                  String              @id @default(uuid())
  userId              String
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  aaConnectionId      String?
  aaConnection        AaConnection?       @relation(fields: [aaConnectionId], references: [id], onDelete: SetNull)
  fipId               String              // e.g. "FIP_HDFC", "FIP_ICICI", "FIP_SBI", "FIP_AXIS"
  bankName            String              // "HDFC Bank", "State Bank of India", etc.
  bankLogoUrl         String?
  accountType         AccountType         @default(SAVINGS)
  accountNumberMasked String              // "XXXXXXXX4091" - Masked only, never raw
  accountRefNumber    String              // Provider FIP reference token
  currency            String              @default("INR")
  balance             Decimal             @default(0.0)
  status              LinkedAccountStatus @default(LINKED)
  linkedAt            DateTime            @default(now())
  lastSyncedAt        DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  transactions        Transaction[]

  @@unique([userId, fipId, accountNumberMasked])
  @@index([userId, status])
  @@map("linked_bank_accounts")
}

model Consent {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  aaConnectionId String?
  aaConnection   AaConnection?  @relation(fields: [aaConnectionId], references: [id], onDelete: SetNull)
  consentHandle  String         @unique // ReBIT consent request handle
  consentId      String?        @unique // Assigned ReBIT consent ID after approval
  purpose        String         // Purpose code & description (e.g., "101 - Wealth management and analytics")
  dataTypes      String[]       @default(["TRANSACTIONS", "PROFILE", "SUMMARY"])
  status         ConsentStatus  @default(PENDING)
  dataRangeFrom  DateTime       @default(now())
  dataRangeTo    DateTime       @default(now())
  fetchFrequency String         @default("DAILY")
  validUntil     DateTime       // Consent expiry date
  grantedAt      DateTime?
  revokedAt      DateTime?
  accounts       Json?          // Array of linked bank account IDs covered by this consent
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  events         ConsentEvent[]

  @@index([userId, status])
  @@map("consents")
}

model ConsentEvent {
  id        String           @id @default(uuid())
  consentId String
  consent   Consent          @relation(fields: [consentId], references: [id], onDelete: Cascade)
  eventType ConsentEventType
  actor     String?          // "USER", "AA_PROVIDER", "SYSTEM"
  reason    String?
  ipAddress String?
  userAgent String?
  payload   Json?
  createdAt DateTime         @default(now())

  @@index([consentId])
  @@map("consent_events")
}

model ProviderCallbackEvent {
  id            String         @id @default(uuid())
  providerId    String
  correlationId String?
  eventType     String         // "ACCOUNT_LINKING", "CONSENT_STATUS", "DISCOVERY"
  signature     String?
  payload       Json
  status        CallbackStatus @default(PROCESSED)
  processedAt   DateTime       @default(now())
  errorMessage  String?

  @@index([providerId, correlationId])
  @@map("provider_callback_events")
}

// ---------------------------------------------------------------------------
// Existing Domain Models (Preserved for compatibility)
// ---------------------------------------------------------------------------

model Account {
  id                  String        @id @default(uuid())
  userId              String
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankName            String
  accountNumberMasked String
  accountType         AccountType   @default(SAVINGS)
  balance             Decimal       @default(0.0)
  currency            String        @default("INR")
  isConnected         Boolean       @default(true)
  aaConnectionId      String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  transactions        Transaction[]

  @@map("accounts")
}

model Transaction {
  id                  String             @id @default(uuid())
  userId              String
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId           String?
  account             Account?           @relation(fields: [accountId], references: [id], onDelete: SetNull)
  linkedBankAccountId String?
  linkedBankAccount   LinkedBankAccount? @relation(fields: [linkedBankAccountId], references: [id], onDelete: SetNull)
  transactionRef      String?            // External provider transaction reference for deduplication
  source              String             @default("MANUAL") // "ACCOUNT_AGGREGATOR" | "MANUAL"
  title               String
  amount              Decimal
  category            String
  type                TransactionType    @default(EXPENSE)
  date                DateTime           @default(now())
  note                String?
  createdAt           DateTime           @default(now())

  @@unique([userId, transactionRef])
  @@index([userId, date])
  @@map("transactions")
}

model Goal {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  targetAmount  Decimal
  currentAmount Decimal   @default(0.0)
  category      String
  deadline      DateTime?
  isCompleted   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("goals")
}

model Trip {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination    String
  budget         Decimal
  spent          Decimal   @default(0.0)
  startDate      DateTime?
  endDate        DateTime?
  travelersCount Int       @default(1)
  isCompleted    Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("trips")
}

model LendingRequest {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason       String
  amount       Decimal
  termMonths   Int           @default(3)
  interestRate Decimal       @default(4.5)
  status       LendingStatus @default(PENDING)
  fundedAmount Decimal       @default(0.0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("lending_requests")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  resource  String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}
