# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# PostgreSQL Connection
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/one_db?schema=public"

# Redis Cache
REDIS_URL="redis://localhost:6379"

# JWT Authentication & Rotation
JWT_SECRET="one_access_secret_key_change_in_production"
JWT_REFRESH_SECRET="one_refresh_secret_key_change_in_production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_DAYS=30

# WebAuthn / FIDO2 Passkeys
RP_NAME="ONE Financial Assistant"
RP_ID="localhost"
ORIGIN="http://localhost:3000"

# SMS / OTP Verification
SMS_PROVIDER="mock"
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_COOLDOWN_SECONDS=45

# Account Aggregator (AA) Ecosystem
AA_MOCK_SANDBOX_ENABLED=true

# Setu AA Bridge (Optional Production Credentials)
SETU_AA_CLIENT_ID="setu_client_id_placeholder"
SETU_AA_CLIENT_SECRET="setu_client_secret_placeholder"
SETU_AA_PRODUCT_INSTANCE_ID="setu_product_instance_id_placeholder"

# OneMoney (CAMS) AA (Optional Production Credentials)
ONEMONEY_AA_CLIENT_ID="onemoney_client_id_placeholder"
ONEMONEY_AA_CLIENT_SECRET="onemoney_client_secret_placeholder"
